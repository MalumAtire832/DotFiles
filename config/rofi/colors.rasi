/* Oxocarbon — IBM Carbon dark
 * https://github.com/nyoom-engineering/oxocarbon
 *
 * Canonical palette for rofi. Edit here; the themes import it and the
 * launcher scripts no longer regenerate this file.
 */

* {
  al:         #00000000;

  /* ground */
  base:       #161616;
  mantle:     #0f0f0f;
  surface:    #262626;
  overlay:    #393939;
  muted:      #525252;
  text:       #dde1e6;
  bright:     #f2f4f8;

  /* hue */
  blue:       #33b1ff;
  lightblue:  #82cfff;
  cyan:       #3ddbd9;
  teal:       #08bdba;
  green:      #42be65;
  yellow:     #f1c21b;
  magenta:    #ee5396;
  pink:       #ff7eb6;
  purple:     #be95ff;

  /* roles used by the themes */
  bg:         @base;      /* window ground            */
  se:         @surface;   /* selected row             */
  fg:         @text;      /* body text                */
  ac:         @blue;      /* accent: focus, prompt    */
  br:         @overlay;   /* rules and window border  */
  pr:         @blue;      /* prompt glyph             */
  en:         @bright;    /* typed query              */
  ph:         @muted;     /* placeholder              */
  sel-fg:     @bright;    /* text on a selected row   */
}
