/* Launcher — oxocarbon (IBM Carbon dark)
 * Form: a flat panel. Square corners, one hairline rule per edge,
 * neutral ground. Hue appears only on focus and on the selected row.
 */

configuration {
  font:                       "JetBrains Mono NF 12";
  show-icons:                 true;
  icon-theme:                 "Papirus";
  display-drun:               "";
  drun-display-format:        "{name}";
  disable-history:            false;
  sidebar-mode:               false;
}

@import "colors.rasi"

window {
  transparency:               "real";
  background-color:           @bg;
  text-color:                 @fg;
  border:                     1px;
  border-color:               @br;
  border-radius:              0px;
  width:                      30%;
  location:                   center;
  x-offset:                   0;
  y-offset:                   0;
}

mainbox {
  background-color:           @al;
  border:                     0px;
  border-radius:              0px;
  children:                   [ inputbar, listview ];
  spacing:                    0px;
  padding:                    0px;
}

/* Carbon text field: recessed cell, focus rule along the bottom edge. */
inputbar {
  children:                   [ prompt, entry ];
  background-color:           @surface;
  text-color:                 @en;
  expand:                     false;
  border:                     0px 0px 1px 0px;
  border-color:               @ac;
  border-radius:              0px;
  margin:                     0px;
  padding:                    12px 16px;
  spacing:                    12px;
}

prompt {
  enabled:                    true;
  background-color:           @al;
  text-color:                 @pr;
  vertical-align:             0.5;
  padding:                    0px;
  font:                       "JetBrains Mono NF 12";
}

entry {
  background-color:           @al;
  text-color:                 @en;
  placeholder-color:          @ph;
  placeholder:                "Search";
  expand:                     true;
  horizontal-align:           0;
  vertical-align:             0.5;
  padding:                    0px;
  blink:                      true;
}

listview {
  background-color:           @al;
  padding:                    0px;
  columns:                    1;
  lines:                      8;
  spacing:                    0px;
  cycle:                      false;
  dynamic:                    true;
  scrollbar:                  false;
  layout:                     vertical;
}

/* Every row is a cell of the same height. The 2px leading edge is
 * reserved on every row, transparent until the row is selected, so
 * nothing shifts as the selection moves. */
element {
  background-color:           @al;
  text-color:                 @fg;
  orientation:                horizontal;
  border:                     0px 0px 0px 2px;
  border-color:               @al;
  border-radius:              0px;
  padding:                    8px 16px;
  spacing:                    12px;
}

element-icon {
  background-color:           inherit;
  text-color:                 inherit;
  horizontal-align:           0.5;
  vertical-align:             0.5;
  size:                       24px;
  border:                     0px;
}

element-text {
  background-color:           @al;
  text-color:                 inherit;
  expand:                     true;
  horizontal-align:           0;
  vertical-align:             0.5;
  margin:                     0px;
}

element normal active {
  text-color:                 @lightblue;
}

/* Selection: lifted ground plus an accent bar on the leading edge. */
element selected {
  background-color:           @se;
  text-color:                 @sel-fg;
  border:                     0px 0px 0px 2px;
  border-color:               @ac;
  border-radius:              0px;
}

element selected active {
  background-color:           @se;
  text-color:                 @lightblue;
}
