/* Power menu — oxocarbon (IBM Carbon dark)
 * Same flat panel as the launcher, narrower, no icon column.
 * Destructive confirmations read in magenta; everything else neutral.
 */

configuration {
  font:                           "JetBrains Mono NF 12";
  drun-display-format:            "{name}";
  disable-history:                false;
  sidebar-mode:                   false;
}

@import "colors.rasi"

window {
  transparency:                   "real";
  background-color:               @bg;
  text-color:                     @fg;
  border:                         1px;
  border-color:                   @br;
  border-radius:                  0px;
  width:                          20%;
  location:                       center;
  x-offset:                       0;
  y-offset:                       0;
}

mainbox {
  background-color:               @al;
  border:                         0px;
  border-radius:                  0px;
  children:                       [ inputbar, listview ];
  spacing:                        0px;
  padding:                        0px;
}

/* The prompt is a header here, not a field: "Power menu" / "Are you sure". */
inputbar {
  children:                       [ prompt ];
  background-color:               @surface;
  text-color:                     @bright;
  expand:                         false;
  border:                         0px 0px 1px 0px;
  border-color:                   @ac;
  border-radius:                  0px;
  margin:                         0px;
  padding:                        12px 16px;
}

prompt {
  enabled:                        true;
  background-color:               @al;
  text-color:                     @bright;
  vertical-align:                 0.5;
  padding:                        0px;
  font:                           "JetBrains Mono NF 12";
}

entry {
  enabled:                        false;
  background-color:               @al;
  text-color:                     @en;
  placeholder-color:              @ph;
  expand:                         true;
  horizontal-align:               0;
  vertical-align:                 0.5;
  padding:                        0px;
  blink:                          true;
}

listview {
  background-color:               @al;
  padding:                        0px;
  columns:                        1;
  lines:                          6;
  spacing:                        0px;
  cycle:                          false;
  dynamic:                        true;
  scrollbar:                      false;
  layout:                         vertical;
}

/* 2px leading edge reserved on every row so nothing shifts on selection. */
element {
  background-color:               @al;
  text-color:                     @fg;
  orientation:                    horizontal;
  border:                         0px 0px 0px 2px;
  border-color:                   @al;
  border-radius:                  0px;
  padding:                        10px 16px;
  spacing:                        12px;
}

element-icon {
  background-color:               inherit;
  text-color:                     inherit;
  horizontal-align:               0.5;
  vertical-align:                 0.5;
  size:                           0px;
  border:                         0px;
}

element-text {
  background-color:               @al;
  text-color:                     inherit;
  expand:                         true;
  horizontal-align:               0;
  vertical-align:                 0.5;
  margin:                         0px;
}

element selected {
  background-color:               @se;
  text-color:                     @sel-fg;
  border:                         0px 0px 0px 2px;
  border-color:                   @ac;
  border-radius:                  0px;
}

element urgent {
  text-color:                     @magenta;
}

element selected urgent {
  background-color:               @se;
  text-color:                     @magenta;
}
