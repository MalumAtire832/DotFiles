layout {
    tab name="Primary" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="vertical" {
            pane {
                name "File Explorer"
                command "broot"
                // See config/zellij/layouts/ide.kdl: broot's file watcher
                // is off by default, so new files need :toggle_watch to
                // show up without a manual refresh.
                args "-c" ":toggle_watch"
                size "15%"
            }
            pane size="85%" {
                pane {
                    name "Main"
                    command "hx"
                    size "80%"
                }
                pane {
                    name "Console"
                    // Explicit "." rather than leaving cwd unset: a bare
                    // pane with no command resolves its cwd through a
                    // different code path than broot/hx's command panes,
                    // and doesn't reliably pick up --default-cwd on its
                    // own. This forces it through cwd composition instead.
                    cwd "."
                    size "20%"
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="Version Control" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane {
            name "LayzGit"
            command "lazygit"
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
}
