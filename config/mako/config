# Oxocarbon — IBM Carbon dark
# https://github.com/nyoom-engineering/oxocarbon
#
# Borders follow sway's window colours: blue for a normal notification,
# magenta for an urgent one, matching client.focused and client.urgent.

background-color=#161616
text-color=#dde1e6
border-color=#33b1ff
progress-color=over #262626

font=Iosevka Nerd Font 12

[urgency=low]
border-color=#525252
text-color=#dde1e6

[urgency=high]
border-color=#ee5396

# Brave fires this every time picture-in-picture activates (see the
# for_window rule in sway's config that tiles it), purely informational
# and not something to acknowledge each time.
[app-name="Brave" summary="Video Popout"]
invisible=1
